# Copy to .env and fill in. Never commit .env; treat it like a password file.

# Password for the /admin dashboard. Without it the dashboard is switched off.
ADMIN_PASSWORD=

# Google OAuth client, from Google Cloud Console (see README, "Connect Google Calendar").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only if you reach the app at an address other than http://localhost:8080,
# for example through a tunnel. Must match a redirect URI registered in Google.
# PUBLIC_BASE_URL=https://display.example.com

# Only if port 8080 is already used on this machine (a NAS often has something there).
# The address then becomes http://<machine>:8081 (or whichever port you pick).
# HOST_PORT=8081

# Only for the optional "tunnel" compose profile.
# CLOUDFLARE_TUNNEL_TOKEN=
