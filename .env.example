# Copy to .env (gitignored). Referenced from config.yaml as ${NAME}.
# Never commit the real file; treat it like a password file.

# Google OAuth client (slice 2). Create one in Google Cloud Console and
# publish the project to "In production" or tokens expire after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret iCal address, only if you use the iCal provider.
# KITCHEN_ICAL_URL=

# Optional per-screen token (a long random string).
# PARENTS_SCREEN_TOKEN=

# Where browsers reach this app; must match a redirect URI registered in Google.
# PUBLIC_BASE_URL=http://localhost:8080

# Password for the /admin dashboard (settings, calendars, photos, connecting accounts).
# Leave empty to turn the dashboard off.
ADMIN_PASSWORD=
