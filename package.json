{
  "name": "home-display",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted wall display: Google Calendar agenda, clock and photo background",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["server", "web"],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint --workspaces",
    "test": "npm test -w server",
    "start": "npm start -w server"
  }
}
